=========================================
ROUTER PUERTO PLATA
AREA 0 - ISP
AREA 2 - PUERTO PLATA
=========================================

enable
configure terminal

interface e0/0
description Conexion Switch Puerto Plata
no shutdown
exit

interface e0/0.55
encapsulation dot1Q 55
ip address 192.168.7.1 255.255.255.128
exit

interface e0/0.60
encapsulation dot1Q 60
ip address 192.168.7.129 255.255.255.128
exit

interface e0/1
description Conexion ISP
ip address 19.0.0.13 255.255.255.252
no shutdown
exit

router ospf 1
router-id 10.10.2.1
network 19.0.0.12 0.0.0.3 area 0
network 192.168.7.0 0.0.0.127 area 2
network 192.168.7.128 0.0.0.127 area 2
exit

end
write memory


