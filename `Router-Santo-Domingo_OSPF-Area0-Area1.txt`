=========================================
ROUTER SANTO DOMINGO
AREA 0 - ISP
AREA 1 - SANTO DOMINGO
=========================================

enable
configure terminal

interface e0/0
description Conexion Multicapa 1
ip address 192.168.9.1 255.255.255.252
no shutdown
exit

interface e0/1
description Conexion Multicapa 2
ip address 192.168.9.5 255.255.255.252
no shutdown
exit

interface e0/2
description Conexion ISP
ip address 19.0.0.1 255.255.255.252
no shutdown
exit

router ospf 1
router-id 10.10.1.1
network 19.0.0.0 0.0.0.3 area 0
network 192.168.9.0 0.0.0.3 area 1
network 192.168.9.4 0.0.0.3 area 1
exit

end
write memory

