--------------------------------------------
MultiCapa Conectado al VTP Santo Domingo
--------------------------------------------
enable
configure terminal
banner motd # 
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!	PROHIBIDO ACCESO SIN PERMISO 	!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#
hostname R-SW2-VTP-Cliente
line console 0
exec-timeout 15
password quisqueya
login local
exit

ip domain-name tufuturo.com.do
spanning-tree mode rapid-pvst
crypto key generate rsa
2046
ip ssh version 2
username Efren privilege 15 password tigre
username Ezequiel privilege 15 password leon
username Oliver privilege 7 password aguila
username Justin privilege 7 password lobo
line vty 0 4
exec-timeout 15
transport input ssh
login local
logging synchronous
password quisqueya
exit
ip ssh version 2
service password-encryption

interface range e0/1-3
description Interfaz Port-Channel
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 100
switchport trunk allow	vlan all
description Conexion Para Etherchannel
spanning-tree link-type point-to-point
no shutdown
channel-protocol lacp
channel-group 1 mode active
exit
interface port-channel 1
description Interfaz Port-Channel
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 100
switchport trunk allow	vlan all
exit

interface range e1/0-2
description Conectado a los Switch LAN
spanning-tree link-type point-to-point
no shutdown
switchport trunk encapsulation dot1q
switchport mode trunk
switchport trunk native vlan 100
switchport trunk allow	vlan all
exit

interface e0/0
spanning-tree link-type point-to-point
description Conectado al Router
no shutdown
switchport trunk encapsulation dot1q
switchport mode trunk 
switchport trunk native vlan 100
switchport trunk allow vlan all
exit


VTP version 2
VTP mode client
VTP domain Futuro
VTP password quisqueya

do wr

